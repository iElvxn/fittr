# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real credentials.

# Supabase project (Settings > API in the Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud OAuth "Web application" client ID (used as GoogleSignin's
# webClientId — this is the audience Supabase actually validates, NOT the
# iOS client ID). Configure both the Web and iOS client IDs, comma-separated,
# in the Supabase dashboard's Google provider settings, with "Skip nonce
# check" enabled for iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Sentry (crash reporting) — no events are sent until this is a real DSN.
SENTRY_DSN=

# PostHog (product analytics) — no events are sent until these are real values.
POSTHOG_API_KEY=
POSTHOG_HOST=
