# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real credentials.

# Supabase project (Settings > API in the Supabase dashboard)
# Use the "publishable key" (sb_publishable_...) — the modern, client-safe
# successor to the legacy anon/JWT key. Both work, but Supabase is
# deprecating the legacy anon/service_role keys by end of 2026.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service_role key (Settings > API) — bypasses RLS entirely.
# Used ONLY by supabase/tests/rls.test.ts (the supabase-integration Jest
# project, not the app) to create pre-confirmed test users via the Admin
# API without sending real confirmation emails. NEVER prefix this with
# EXPO_PUBLIC_ — that prefix gets bundled into the client app, which would
# ship a database-wide RLS-bypass credential to every user's device.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud OAuth "Web application" client ID (used as GoogleSignin's
# webClientId — this is the audience Supabase actually validates, NOT the
# iOS client ID). Configure both the Web and iOS client IDs, comma-separated,
# in the Supabase dashboard's Google provider settings, with "Skip nonce
# check" enabled for iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Cloud OAuth "iOS" client ID (used as GoogleSignin's iosClientId).
# Required on iOS since we don't ship a GoogleService-Info.plist — without
# it the native SDK throws "failed to determine clientID".
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Sentry (crash reporting) — no events are sent until this is a real DSN.
SENTRY_DSN=

# PostHog (product analytics) — no events are sent until these are real values.
POSTHOG_API_KEY=
POSTHOG_HOST=
