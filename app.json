{
  "expo": {
    "name": "Fittr",
    "slug": "fittr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fittr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.elvinly.fittr",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.873379067038-sqj4nk03ma6lmtn19hp532usomtgir47"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fittr accesses your photo library so you can choose a profile avatar or add wardrobe items.",
          "cameraPermission": "Fittr uses your camera to photograph clothing items to add to your wardrobe."
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98601fda-12e4-444b-aeac-5683b0298186"
      }
    },
    "owner": "elvinly323"
  }
}
